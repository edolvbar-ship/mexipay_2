                                                {
                                                    "EnvironmentType": {
                                                        "Ref": "EnvironmentType"
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "Fn::ImportValue": {
                                            "Fn::Sub": [
