# .ebextensions/01-nginx-proxy.config
# This ensures nginx passes through ALL headers to your Node.js app

files:
  "/etc/nginx/conf.d/00_application.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      upstream nodejs_app {
        server 127.0.0.1:8081;
        keepalive 256;
      }

      server {
        listen 80 default_server;
        listen [::]:80 default_server;

        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;

        # Security headers
        server_tokens off;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;

        # ✅ CRITICAL: Pass ALL headers to Node.js
        location / {
          # Debug headers to verify JWT is received
          add_header X-Backend-Debug "JWT-Proxy-Enabled" always;
          add_header X-Auth-Header-Received "$http_authorization" always;

          # Proxy configuration
          proxy_pass http://nodejs_app;
          proxy_http_version 1.1;
          proxy_set_header Connection "";

          # ✅ FORWARD ALL HEADERS - This is what you're missing!
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Request-ID $request_id;

          # ✅ CRITICAL: Pass Authorization header explicitly
          proxy_set_header Authorization $http_authorization;
          proxy_set_header X-Original-Authorization $http_authorization;

          # Pass all other headers
          proxy_pass_request_headers on;
          proxy_pass_request_body on;

          # Timeouts
          proxy_connect_timeout 60s;
          proxy_send_timeout 120s;
          proxy_read_timeout 120s;
        }

        # Health check endpoint
        location /health {
          access_log off;
          return 200 '{"status":"healthy","service":"nodejs-backend"}';
          add_header Content-Type application/json;
        }

        # Debug endpoint to check headers
        location /debug/headers {
          add_header Content-Type application/json;
          add_header X-Debug-Mode "enabled";

          return 200 '{
            "authorization_header": "$http_authorization",
            "x_authorization": "$http_x_authorization",
            "all_headers": {
              "host": "$http_host",
              "user_agent": "$http_user_agent",
              "x_forwarded_for": "$http_x_forwarded_for",
              "x_real_ip": "$http_x_real_ip",
              "x_request_id": "$http_x_request_id"
            },
            "backend": "nodejs-app"
          }';
        }
      }

container_commands:
  01_restart_nginx:
    command: "systemctl restart nginx"
    ignoreErrors: true